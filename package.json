{
  "name": "aigifmaker",
  "version": "0.1.0",
  "description": "Official SDK for AI GIF Maker (aigifmaker.ai): turn text into animated GIFs.",
  "type": "module",
  "main": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": { ".": { "types": "./dist/mod.d.ts", "default": "./dist/mod.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "keywords": ["ai", "gif", "gif-maker", "ai-gif-generator", "text-to-gif", "animated-gif", "aigifmaker"],
  "homepage": "https://aigifmaker.ai/?utm_source=npm&utm_medium=package",
  "repository": { "type": "git", "url": "git+https://github.com/hanshs474/aigifmaker-ts.git" },
  "bugs": "https://github.com/hanshs474/aigifmaker-ts/issues",
  "license": "MIT",
  "author": "hanshs474",
  "scripts": {
    "build": "tsc mod.ts --outDir dist --declaration --target es2022 --module es2022 --moduleResolution bundler --lib es2022,dom --skipLibCheck",
    "test": "node --test test.mjs",
    "smoke": "node --test smoke.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
